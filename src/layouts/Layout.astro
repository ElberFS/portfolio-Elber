---
import Navbar from "../components/desktop/Navbar.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro Basics</title>
    </head>
    <body class="bg-svg-background">
        <Navbar />
        <slot />
    </body>
</html>




<style>
    html,
    body {
        scroll-behavior: smooth;
        margin: 0;
        width: 100%;
        height: 100%;
    }

    /* Estilo para el fondo SVG */
    body.bg-svg-background {
        background: url('../../public/svg/background.svg') no-repeat center center fixed;
        background-size: cover;
        background-attachment: fixed;
    }
</style>