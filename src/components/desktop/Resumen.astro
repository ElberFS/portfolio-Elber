---
import "../../styles/global.css";
---

<div class="w-full bg-white">
    {/* Sección de Resumen, Habilidades y Experiencia */}
    <div id="Resumen" class="max-w-7xl mx-auto p-8">
        {
            /* Contenedor principal con una grilla de dos columnas en pantallas medianas y grandes */
        }
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20">
            {
                /* Columna Izquierda: Resumen, Habilidades Personales y Estudios */
            }
            <div>
                {/* Sección de Resumen */}
                <h2
                    class="w-fit font-AgencyFB-bold text-2xl uppercase border-b-2 border-black pb-2 mb-4"
                >
                    Resumen
                </h2>
                <p class="font-AgencyFB-regular text-xl mb-8">
                    Bachiller en Ingeniería en Computación e Informática por la
                    Universidad Nacional Pedro Ruiz Gallo, con un año de experiencia y participación en
                    desarrollo web y soporte técnico en entornos universitarios.
                    Formación complementaria en PHP, Laravel, bases de datos y
                    diseño UX/UI. Busco oportunidades como desarrollador junior,
                    con interés en trabajo remoto y en contribuir al desarrollo
                    y mantenimiento de aplicaciones web.
                </p>

                {/* Sección de Habilidades Personales */}
                <h2
                    class="w-fit font-AgencyFB-bold text-2xl uppercase border-b-2 border-black pb-2 mb-4"
                >
                    Habilidades Personales
                </h2>
                <div
                    class="grid text-xl font-AgencyFB-regular grid-cols-2 gap-1 mb-8"
                >
                    {/* Mapeo de la lista de habilidades personales */}
                    {
                        [
                            "Pensamiento analítico",
                            "Adaptabilidad",
                            "Resolución de problemas",
                            "Organización",
                            "Pensamiento lógico",
                            "Gestión del tiempo",
                            "Creatividad",
                            "Proactividad",
                            "Atención al detalle",
                            "Responsabilidad",
                            "Comunicación clara",
                            "Aprendizaje continuo",
                            "Trabajo en equipo",
                            "Resiliencia",
                        ].map((skill) => <div class="p-1">{skill}</div>)
                    }
                </div>

                {/* Sección de Estudios */}
                <h2
                    class="w-fit font-AgencyFB-bold text-2xl uppercase border-b-2 border-black pb-2 mb-4"
                >
                    Estudios
                </h2>
                <div class="space-y-2 text-xl font-AgencyFB-regular">
                    <h3 class="text-xl font-AgencyFB-bold">
                        Universidad Nacional Pedro Ruiz Gallo
                    </h3>
                    <p class="text-xl font-AgencyFB-regular text-gray-600">
                        2020 - 2025
                    </p>
                    <p class="text-xl font-AgencyFB-regular">
                        Ingeniería en Computación e Informática
                    </p>
                    <p class="text-gray-600">Egreso: 24 de enero de 2025. Tercio superior en el ciclo 2024-II, promedio ponderado 15.47.</p>
                    <div class="mt-6 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
                        <a href="/pdf/bachiller.pdf" target="_blank" rel="noopener noreferrer" aria-label="Ver diploma de bachiller en PDF">
                            <img
                                src="/image/certificados/bachiller.jpg"
                                alt="Diploma de bachiller de Elber Jesús Quiroz Coronel, Universidad Nacional Pedro Ruiz Gallo"
                                class="w-full h-auto"
                                loading="lazy"
                            />
                        </a>
                        <div class="p-4">
                            <h3 class="font-AgencyFB-bold text-xl">
                                Bachiller en Ingeniería en Computación e Informática
                            </h3>
                            <p class="mt-2 text-gray-600">
                                Grado obtenido el 5 de enero de 2026
                            </p>
                            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                                <a href="/pdf/bachiller.pdf" target="_blank" rel="noopener noreferrer" class="text-black underline">
                                    Ver diploma
                                </a>
                                <a href="/pdf/bachiller.pdf" download="Bachiller_Elber_Quiroz.pdf" class="bg-gray-300 text-black px-4 py-1 font-AgencyFB-bold">
                                    Descargar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {/* Columna Derecha: Experiencia Laboral */}
            <div>
                <h2
                    class="w-fit text-2xl font-AgencyFB-bold uppercase border-b-2 border-black pb-2 mb-4"
                >
                    Experiencia
                </h2>

                {/* Contenedor para la lista de experiencias laborales */}
                <div class="space-y-6 text-xl font-AgencyFB-regular">
                    {/* Item de Experiencia Laboral 1 */}
                    <div
                        class="relative pl-8 before:absolute before:left-2 before:top-0 before:bottom-0 before:w-0.5 before:bg-gray-400"
                    >
                        <div></div>
                        <h3 class="font-AgencyFB-bold">
                            Universidad Nacional Pedro Ruiz Gallo
                        </h3>
                        <p class="text-xl text-gray-600">
                            01 Oct 2024 - 31 Dic 2024
                        </p>
                        <p class="font-semibold">
                            Desarrollo web - Prácticas preprofesionales
                        </p>
                        <p class="text-gray-700">
                            Diseño y publicación del sitio web de la Oficina de
                            Cooperación y Relaciones Internacionales.
                            <a href="https://ocyri.unprg.edu.pe/" target="_blank" rel="noopener noreferrer" class="underline">Ver sitio de OCYRI</a>.
                        </p>
                    </div>

                    {/* Item de Experiencia Laboral 2 */}
                    <div
                        class="relative pl-8 before:absolute before:left-2 before:top-0 before:bottom-0 before:w-0.5 before:bg-gray-400"
                    >
                        <div></div>
                        <h3 class="font-AgencyFB-bold">
                            Universidad Nacional Pedro Ruiz Gallo
                        </h3>
                        <p class="text-xl text-gray-600">
                            01 Abr 2024 - 01 Ago 2024
                        </p>
                        <p class="font-semibold">
                            Soporte técnico - OTI · Bolsa de trabajo
                        </p>
                        <p class="text-gray-700">
                            Soporte técnico a dependencias académicas y
                            administrativas, consolidando conocimientos en
                            desarrollo de actividades técnicas en toda la
                            Universidad Nacional Pedro Ruiz Gallo.
                        </p>
                    </div>
                    {/* Item de Experiencia Laboral 3 */}
                    <div
                        class="relative pl-8 before:absolute before:left-2 before:top-0 before:bottom-0 before:w-0.5 before:bg-gray-400"
                    >
                        <div></div>
                        <h3 class="font-AgencyFB-bold">
                            Universidad Nacional Pedro Ruiz Gallo
                        </h3>
                        <p class="text-xl text-gray-600">
                            12 Sep 2023 - 29 Nov 2023
                        </p>
                        <p class="font-semibold">
                            Soporte informático - FIME · Prácticas preprofesionales
                        </p>
                        <p class="text-gray-700">
                            240 horas de prácticas en la Facultad de Ingeniería
                            Mecánica y Eléctrica. Instalación de software,
                            mantenimiento preventivo y correctivo de equipos,
                            apoyo en redes, configuración IPv4, imágenes de sistema
                            y puntos de restauración. Asistencia al personal administrativo.
                        </p>
                    </div>
                </div>
                <h2 class="w-fit text-2xl font-AgencyFB-bold uppercase border-b-2 border-black pb-2 mt-10 mb-4">Conocimientos técnicos</h2>
                <p class="font-AgencyFB-regular text-xl">PHP, Laravel, PostgreSQL, MySQL, Oracle y MongoDB; CSS, Figma y diseño UX/UI; fundamentos de Python y redes; Excel y Google Workspace.</p>
                <h2 class="w-fit text-2xl font-AgencyFB-bold uppercase border-b-2 border-black pb-2 mt-8 mb-4">Idiomas</h2>
                <p class="font-AgencyFB-regular text-xl">Inglés: EF SET 82/100, nivel C2 en lectura y comprensión auditiva (abril de 2025).</p>
                <a href="https://cert.efset.org/es/achiLB" target="_blank" rel="noopener noreferrer" class="font-AgencyFB-regular text-xl underline">Ver certificado EF SET</a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos para las fuentes personalizadas */
    .font-AgencyFB-regular {
        font-family: "AgencyFB regular", sans-serif;
    }
    .font-AgencyFB-bold {
        font-family: "AgencyFB bold", sans-serif;
    }
</style>
